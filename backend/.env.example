# Copia este archivo a .env y llena los valores reales.
# .env nunca se sube a git (ya esta en .gitignore).

# Conexion directa a Postgres de Supabase.
# Formato: postgresql://postgres:TU_PASSWORD@db.TU_PROYECTO.supabase.co:5432/postgres
# El TU_PROYECTO es la parte antes de ".supabase.co" en tu Project URL.
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.qmlhjacduuvptxglqxqn.supabase.co:5432/postgres

# Puerto local del servidor Express
PORT=3000

# URL del proyecto de Supabase (para verificar JWT via JWKS publico).
# Settings -> API -> Project URL
SUPABASE_URL=https://tu-proyecto.supabase.co

# Origenes permitidos por CORS (separados por coma). En produccion usar la URL de Netlify.
FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# Stripe: claves de la API y del webhook de suscripciones premium.
# Dashboard -> Developers -> API keys / Webhooks.
# Recomendado: usar una Restricted Key (rk_...) en vez de la Secret Key
# completa (sk_...), con permisos de escritura solo en Checkout Sessions
# y lectura/escritura en Customers -- no la llave con acceso total.
STRIPE_SECRET_KEY=rk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price ID del plan premium recurrente (creado manualmente en el Dashboard de Stripe).
STRIPE_PREMIUM_PRICE_ID=price_...

# Cloudflare Turnstile: verifica que quien publica/comenta en el debate es
# humano. Dashboard de Cloudflare -> Turnstile -> tu sitio -> Secret Key.
# IMPORTANTE: si esta variable no esta configurada, verificarTurnstile()
# en foro.js OMITE la verificacion en vez de fallar (a proposito, para no
# romper el desarrollo local) -- eso significa que si se te olvida
# configurarla en producción, la proteccion contra bots queda desactivada
# SIN ningun error visible. Confirmar siempre que este puesta en el panel
# de variables de entorno de Render antes de dar el sitio por protegido.
TURNSTILE_SECRET_KEY=0x...

# Anthropic (Claude): usada por el Investigador y el Redactor en el panel
# de administracion para asistir con la redaccion de Contenidos/Noticias.
# console.anthropic.com -> Settings -> API keys.
ANTHROPIC_API_KEY=sk-ant-...

# beehiiv (newsletter, reemplazo de Mailchimp desde 2026-09-27). Dashboard
# de beehiiv -> Settings -> Integrations -> API. El Publication ID no es
# secreto (empieza con pub_...) pero igual vive aqui por comodidad de
# configuracion junto a la llave.
BEEHIIV_API_KEY=...
BEEHIIV_PUBLICATION_ID=pub_...
