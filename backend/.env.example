# Copia este archivo a .env y llena los valores reales.
# .env nunca se sube a git (ya esta en .gitignore).

# Conexion directa a Postgres de Supabase.
# Formato: postgresql://postgres:TU_PASSWORD@db.TU_PROYECTO.supabase.co:5432/postgres
# El TU_PROYECTO es la parte antes de ".supabase.co" en tu Project URL.
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.qmlhjacduuvptxglqxqn.supabase.co:5432/postgres

# Puerto local del servidor Express
PORT=3000

# URL del proyecto de Supabase (para verificar JWT via JWKS publico).
# Settings -> API -> Project URL
SUPABASE_URL=https://tu-proyecto.supabase.co

# Origenes permitidos por CORS (separados por coma). En produccion usar la URL de Netlify.
FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
